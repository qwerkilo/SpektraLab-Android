        <item name="colorSecondary">@color/m3_brand_dark_secondary</item>
        <item name="colorOnSecondary">@color/m3_brand_dark_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_brand_dark_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_brand_dark_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_brand_dark_tertiary</item>
        <item name="colorOnTertiary">@color/m3_brand_dark_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_brand_dark_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_brand_dark_on_tertiary_container</item>
        <item name="colorError">@color/m3_brand_dark_error</item>
        <item name="colorOnError">@color/m3_brand_dark_on_error</item>
        <item name="colorErrorContainer">@color/m3_brand_dark_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_brand_dark_on_error_container</item>
        <item name="android:colorBackground">@color/m3_brand_dark_background</item>
        <item name="colorOnBackground">@color/m3_brand_dark_on_background</item>
        <item name="colorSurface">@color/m3_brand_dark_surface</item>
        <item name="colorOnSurface">@color/m3_brand_dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_brand_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_brand_dark_on_surface_variant</item>
        <item name="colorSurfaceDim">@color/m3_brand_dark_surface_dim</item>
        <item name="colorSurfaceBright">@color/m3_brand_dark_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/m3_brand_dark_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_brand_dark_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_brand_dark_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_brand_dark_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_brand_dark_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/m3_brand_dark_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/m3_brand_dark_on_surface_inverse</item>
        <item name="colorPrimaryInverse">@color/m3_brand_dark_primary_inverse</item>
        <item name="colorOutline">@color/m3_brand_dark_outline</item>
        <item name="colorOutlineVariant">@color/m3_brand_dark_outline_variant</item>
        <item name="colorShadow">@color/m3_brand_dark_shadow</item>
        <item name="colorScrim">@color/m3_brand_dark_scrim</item>
        <item name="colorSurfaceTint">@color/m3_brand_dark_surface_tint</item>
    </style>
</resources>
